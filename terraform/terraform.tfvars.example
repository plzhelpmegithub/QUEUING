# =============================================================================
# terraform.tfvars 예시 — 실제 값으로 교체 후 terraform.tfvars로 저장
# =============================================================================
# ⚠ 이 파일에 실제 비밀번호를 넣은 후 .gitignore에 반드시 추가할 것!
# =============================================================================

aws_region  = "ap-northeast-2"
environment = "prod"

# --- VPC ---
vpc_cidr = "10.0.0.0/16"

# --- EC2 (API 서버) ---
ec2_ami_id        = "ami-0bc151a94289adb52"   # 사용자 지정 AMI (ap-northeast-2)
ec2_instance_type = "t3.micro"                 # 개발: t3.micro / 프로덕션: t3.small 이상
ec2_volume_size   = 20                         # GiB (Docker 이미지 + OS + 로그)

# --- API Docker 이미지 ---
api_image_repo             = "mover14/redis-api-backend"  # Docker Hub 직접 사용. ECR 전환 시 ECR URL로 변경
api_image_tag              = "1.0.8"

# --- Auto Scaling ---
api_desired_count          = 2
api_min_count              = 1
api_max_count              = 10
api_autoscaling_cpu_target = 70

# --- RDS (MariaDB) ---
db_instance_class    = "db.t3.micro"    # 개발: db.t3.micro / 프로덕션: db.t3.small 이상
db_allocated_storage = 20               # GiB
db_name              = "queuing_db"
db_username          = "team2"
db_password          = "YOUR_DB_PASSWORD_HERE"

# --- ElastiCache (Redis) ---
redis_node_type       = "cache.t3.micro"   # 개발: cache.t3.micro / 프로덕션: cache.t3.small 이상
redis_num_cache_nodes = 1

# --- SMTP (Gmail) ---
smtp_user = ""
smtp_pass = ""

# --- reCAPTCHA ---
recaptcha_enabled          = false
recaptcha_secret_key       = ""
recaptcha_allowed_hostnames = "queuing.example.com"

# --- 프론트엔드 (S3 + CloudFront) ---
frontend_bucket_name = "team2-queuing"          # S3 버킷 이름 (전역 고유)
frontend_subdomain   = "www"                     # www.queuing.kr
api_subdomain        = "api"                     # api.queuing.kr

# --- 도메인 (선택사항) ---
# 설정하면 Route 53 + ACM 인증서 + DNS 레코드 자동 생성
# 비워두면 CloudFront 기본 URL + ALB DNS로 접속
domain_name         = "queuing.kr"               # 루트 도메인
acm_certificate_arn = ""                          # ALB용 ACM 인증서 (ap-northeast-2). 별도 발급 필요
