{
  "Comment": "QUEUING B-part - resale ticket sequential allocation workflow.",
  "StartAt": "GetNextUser",
  "States": {
    "GetNextUser": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-get-next-user",
        "Payload": {
          "event_id.$": "$.event_id",
          "session_date.$": "$.session_date",
          "session_time.$": "$.session_time"
        }
      },
      "ResultSelector": {
        "has_candidate.$": "$.Payload.has_candidate",
        "candidate.$": "$.Payload"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "HasCandidate?"
    },

    "HasCandidate?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.has_candidate",
          "BooleanEquals": true,
          "Next": "GenerateSignedLink"
        }
      ],
      "Default": "NoCandidateAvailable"
    },

    "NoCandidateAvailable": {
      "Type": "Succeed"
    },

    "GenerateSignedLink": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-generate-signed-link",
        "Payload": {
          "event_id.$": "$.candidate.event_id",
          "user_id.$": "$.candidate.user_id",
          "queue_index.$": "$.candidate.queue_index",
          "session_date.$": "$.candidate.session_date",
          "session_time.$": "$.candidate.session_time"
        }
      },
      "ResultSelector": {
        "event_id.$": "$.Payload.event_id",
        "user_id.$": "$.Payload.user_id",
        "queue_index.$": "$.Payload.queue_index",
        "session_date.$": "$.Payload.session_date",
        "session_time.$": "$.Payload.session_time",
        "allocation_id.$": "$.Payload.allocation_id",
        "token.$": "$.Payload.token",
        "expires_at.$": "$.Payload.expires_at",
        "hold_duration_seconds.$": "$.Payload.hold_duration_seconds"
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "SendEmailAndWait"
    },

    "SendEmailAndWait": {
      "Comment": "waitForTaskToken: response does not end the state; /verify-link calls SendTaskSuccess, or TimeoutSecondsPath elapses -> States.Timeout, or /verify-link/expire calls SendTaskFailure(error='UserExpired').",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSecondsPath": "$.hold_duration_seconds",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-send-email-via-ses",
        "Payload": {
          "event_id.$": "$.event_id",
          "user_id.$": "$.user_id",
          "queue_index.$": "$.queue_index",
          "token.$": "$.token",
          "expires_at.$": "$.expires_at",
          "hold_duration_seconds.$": "$.hold_duration_seconds",
          "TaskToken.$": "$$.Task.Token"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.error",
          "Next": "MarkExpired"
        },
        {
          "ErrorEquals": ["UserExpired"],
          "ResultPath": "$.error",
          "Next": "MarkExpired"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PushToDLQ"
        }
      ],
      "Next": "MarkCompleted"
    },

    "MarkCompleted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-update-allocation-status",
        "Payload": {
          "event_id.$": "$.event_id",
          "user_id.$": "$.user_id",
          "token.$": "$.token",
          "status": "COMPLETED"
        }
      },
      "ResultSelector": {
        "event_id.$": "$.Payload.event_id",
        "has_more_seats.$": "$.Payload.has_more_seats",
        "session_date.$": "$.Payload.session_date",
        "session_time.$": "$.Payload.session_time"
      },
      "Next": "HasMoreSeats?"
    },

    "MarkExpired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-update-allocation-status",
        "Payload": {
          "event_id.$": "$.event_id",
          "user_id.$": "$.user_id",
          "token.$": "$.token",
          "status": "EXPIRED"
        }
      },
      "ResultSelector": {
        "event_id.$": "$.Payload.event_id",
        "has_more_seats.$": "$.Payload.has_more_seats",
        "session_date.$": "$.Payload.session_date",
        "session_time.$": "$.Payload.session_time"
      },
      "Next": "HasMoreSeats?"
    },

    "HasMoreSeats?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.has_more_seats",
          "BooleanEquals": true,
          "Next": "GetNextUser"
        }
      ],
      "Default": "AllSeatsSold"
    },

    "AllSeatsSold": {
      "Type": "Succeed"
    },

    "PushToDLQ": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:ap-northeast-2:230790682749:function:queuing-b-push-to-dlq",
        "Payload": {
          "event_id.$": "$.event_id",
          "user_id.$": "$.user_id",
          "queue_index.$": "$.queue_index",
          "token.$": "$.token"
        }
      },
      "ResultPath": "$.dlq_result",
      "Next": "GetNextUser"
    }
  }
}
