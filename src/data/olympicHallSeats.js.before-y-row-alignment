// 전체 추출 데이터(기존 Floor 포함) 수. 실제 CSV 매핑용 수는 아래
// OLYMPIC_HALL_CSV_TOTAL_SEATS(2,429)를 사용한다.
export const OLYMPIC_HALL_TOTAL_SEATS = 3316;

// 좌석 매핑에 사용하는 CSV 원본 구역 목록.
// 현재 D:\\claude_share\\olympic 폴더의 CSV는 Floor석 파일 없이
// A1~I3 20개 구역으로 구성되어 있으므로, 이 목록도 CSV와 동일하게
// Floor를 제외한 좌석만 제공한다.
export const OLYMPIC_HALL_CSV_ZONES = OLYMPIC_HALL.zones.filter((zone) => zone.id !== 'Floor');
export const OLYMPIC_HALL_CSV_TOTAL_SEATS = OLYMPIC_HALL_CSV_ZONES.reduce(
  (total, zone) => total + zone.seats.length,
  0,
);

// Floor석은 배경 이미지의 초록색 영역을 37열 x 24행으로 균일 배치하므로
// 원본 좌표 목록의 887개보다 한 칸 늘린 888석을 인터랙티브 좌석으로 사용한다.
export const OLYMPIC_HALL_FLOOR_SEAT_COUNT = 888;
export const OLYMPIC_HALL_INTERACTIVE_TOTAL_SEATS =
  OLYMPIC_HALL_CSV_TOTAL_SEATS + OLYMPIC_HALL_FLOOR_SEAT_COUNT;
